# Contributor: Claude <noreply@anthropic.com>
# Contributor: meow <aur at mreow full point org>
# Contributor: John Regan <john@jrjrtech.com>
#
# Override of AUR `fluxer-git` (r192.a45693f-1 at 7d48963abedc),
# edited by hand. Permanent: see override.conf.

pkgname=fluxer-git
_pkgname=fluxer
pkgver=r192.a45693f
pkgrel=1
pkgdesc="A free and open source instant messaging and VoIP platform built for friends, groups, and communities."
arch=('x86_64' 'aarch64')
url="https://fluxer.app/"
license=('AGPL-3.0-or-later')
options=('!lto')
provides=('fluxer')
conflicts=('fluxer')
_nodever=20
# AUR's PKGBUILD predates three upstream changes: the linux-audio-capture
# addon, which links libpipewire (the webauthn addon links libfido2 the same
# way); the app's WebAssembly modules, built for wasm32-unknown-unknown
# (rust-wasm); and Linux packaging with upstream's patched Electron instead
# of Arch's (see prepare()).
depends=(
  'libpipewire'
  'libfido2'
)
makedepends=(
  'git'
  "nodejs>=$_nodever"
  'npm'
  'pnpm'
  'python'
  'rust'
  'rust-wasm'
  'clang'
  'libfido2'
  'libpipewire'
)
source=(
  "$_pkgname::git+https://github.com/fluxerapp/fluxer.git#branch=main"
)
sha256sums=(
  'SKIP'
)

pkgver() {
    cd "$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$_pkgname/fluxer_desktop"

    # Upstream packages Linux only with its patched Electron (a Chromium
    # VA-API fix), published as a GitHub release that electron/runtime.json
    # pins by sha256. The pin follows upstream's main branch, so it is read
    # here rather than listed in source=. electron-builder then checks the
    # archive, its manifest and the patch itself.
    local _arch _tag _version _sha256 _name _url
    case "$CARCH" in
      x86_64) _arch=x64 ;;
      aarch64) _arch=arm64 ;;
    esac
    read -r _tag _version _sha256 < <(python -c '
import json, sys
runtime = json.load(open("electron/runtime.json"))
print(runtime["releaseTag"], runtime["electronVersion"], runtime["linux"][sys.argv[1]]["archiveSha256"])
' "$_arch")
    _name="electron-v${_version}-linux-${_arch}"
    _url="https://github.com/fluxerapp/fluxer/releases/download/${_tag}"
    mkdir -p "$srcdir/electron-dist"
    curl -fsSL --retry 3 -o "$srcdir/electron-dist/${_name}.zip" "${_url}/${_name}.zip"
    curl -fsSL --retry 3 -o "$srcdir/electron-dist/${_name}.fluxer.json" "${_url}/${_name}.fluxer.json"
    echo "${_sha256}  $srcdir/electron-dist/${_name}.zip" | sha256sum -c -

    pnpm install --frozen-lockfile
}

build() {
    local electron_builder_options=(
      --linux
      --dir
    )
    cd "$_pkgname/fluxer_desktop"
    export NODE_ENV=production
    export FLUXER_ELECTRON_DIST="$srcdir/electron-dist"
    # The wasm build cargo-installs its pinned wasm-bindgen-cli, then runs it
    # from PATH.
    export CARGO_HOME="$srcdir/cargo-home"
    export PATH="$CARGO_HOME/bin:$PATH"
    # cc-rs passes CFLAGS to every target, wasm32 included (zstd-sys), and
    # clang rejects makepkg's -march there. Give makepkg's flags to the host
    # target only.
    local _host="${CARCH}_unknown_linux_gnu"
    export "CFLAGS_${_host}=$CFLAGS" "CXXFLAGS_${_host}=$CXXFLAGS"
    unset CFLAGS CXXFLAGS
    pnpm build
    pnpm exec electron-builder --config electron-builder.config.cjs ${electron_builder_options[@]}
}

package() {
    cd "$_pkgname/fluxer_desktop"
    sed -i 's|Exec=app.fluxer.Fluxer|Exec=/usr/lib/fluxer/fluxer|' packaging/linux/app.fluxer.Fluxer.desktop
    install -vDm 644 packaging/linux/app.fluxer.Fluxer.desktop -t "$pkgdir/usr/share/applications/"
    install -vDm 644 packaging/linux/app.fluxer.Fluxer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/app.fluxer.Fluxer.svg"
    install -vdm 755 "$pkgdir/usr/lib/$_pkgname/"
    cp -rv dist-electron/linux-unpacked/* "$pkgdir/usr/lib/$_pkgname/"
}
