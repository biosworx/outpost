# Contributor: Claude <noreply@anthropic.com>
#
# Repackages the prebuilt binary from npm, following the AUR `opencode-beta`
# package. No update.conf: beta versions are published only to npm, not as
# GitHub releases. [extra] ships the stable `opencode`.

pkgname=opencode-beta
pkgver=2.1.4
pkgrel=1
pkgdesc="AI coding agent for the terminal (beta)"
arch=('x86_64')
url="https://github.com/anomalyco/opencode"
license=('MIT')
depends=('glibc' 'gcc-libs' 'ripgrep')
provides=('opencode' 'opencode2')
conflicts=('opencode' 'opencode2')
options=('!strip' '!debug')
# The baseline build runs on CPUs without AVX2.
source=("${pkgname}-${pkgver}.tgz::https://registry.npmjs.org/@opencode/cli-linux-x64-baseline/-/cli-linux-x64-baseline-${pkgver}.tgz"
        'LICENSE'
        'opencode2')
sha256sums=('bfcb5c1931063e9835179ef4f1ee35eb3598d23ec77c31f0d5beedb45419fd25'
            '625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b'
            'cd03022601e4848a957999a2a7b1c1ccf18b94f9a084a44719f62abaacebe83c')

package() {
  install -Dm755 package/bin/opencode "${pkgdir}/usr/bin/opencode"
  install -Dm755 opencode2 "${pkgdir}/usr/bin/opencode2"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
