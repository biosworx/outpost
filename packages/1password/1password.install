# Group that may run the browser integration helper. Do not add users to it.
GROUP_NAME="onepassword"
POLICY="/usr/share/polkit-1/actions/com.1password.1Password.policy"
TEMPLATE="/opt/1Password/com.1password.1Password.policy.tpl"

ensure_group() {
  getent group "${GROUP_NAME}" >/dev/null || groupadd "${GROUP_NAME}"
}

setup_browser_helper() {
  chgrp "${GROUP_NAME}" /opt/1Password/1Password-BrowserSupport
  chmod g+s /opt/1Password/1Password-BrowserSupport
}

# What upstream's install_biometrics_policy.sh does: the CLI and SSH agent
# actions are owned by the first 10 human users (UID 1000-9999). Rewritten on
# every upgrade, so users added since are picked up.
write_policy() {
  [ -d /usr/share/polkit-1/actions ] || return 0
  owners="$(cut -d: -f1,3 /etc/passwd | grep -E ':[0-9]{4}$' | cut -d: -f1 \
    | head -n 10 | sed 's/^/unix-user:/' | tr '\n' ' ')"
  sed "s|\${POLICY_OWNERS}|${owners}|g" "${TEMPLATE}" >"${POLICY}"
  chmod 644 "${POLICY}"
}

pre_install() {
  ensure_group
}

pre_upgrade() {
  ensure_group
}

post_install() {
  setup_browser_helper
  write_policy
}

post_upgrade() {
  post_install
}

post_remove() {
  rm -f "${POLICY}"
  if getent group "${GROUP_NAME}" >/dev/null; then
    groupdel "${GROUP_NAME}"
  fi
}
