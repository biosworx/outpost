# Maintainer: BiosPlus <9003059+BiosPlus@users.noreply.github.com>
# Contributor: Claude <noreply@anthropic.com>
#
# Repackages upstream's release tarball, following the AUR `1password`
# package (maintained by 1Password). Unlike the AUR package, the PolKit policy
# is written at install time (1password.install): its owner list names the
# machine's human users, which CI's build container does not have.

pkgname=1password
pkgver=8.12.42
pkgrel=1
pkgdesc="Password manager and secure wallet"
arch=('x86_64')
url="https://1password.com"
license=('LicenseRef-1Password-Proprietary')
depends=('hicolor-icon-theme' 'libgtk-3.so=0' 'nss' 'xdg-utils')
conflicts=('1password-beta' '1password-beta-bin')
options=('!strip' '!debug')
install="${pkgname}.install"
# Upstream also publishes a detached .sig (key 3FEF9748469ADBE15DA7CA80AC2D62742012EA22).
# CI has no way to import that key, so the signature is checked by hand when
# bumping and the checksum pins the verified tarball.
source=("https://downloads.1password.com/linux/tar/stable/x86_64/${pkgname}-${pkgver}.x64.tar.gz")
sha256sums=('2ce64d1bd53dd6fd4408739a079d10be01aff35cb4e8eaeca3dc9b7c6a8418de')

package() {
  cd "${pkgname}-${pkgver}.x64"

  local res
  for res in 32x32 64x64 256x256 512x512; do
    install -Dm644 "resources/icons/hicolor/${res}/apps/1password.png" \
      "${pkgdir}/usr/share/icons/hicolor/${res}/apps/1password.png"
  done
  install -Dm644 resources/com.onepassword.OnePassword.desktop -t "${pkgdir}/usr/share/applications/"
  install -Dm644 resources/custom_allowed_browsers -t "${pkgdir}/usr/share/doc/${pkgname}/examples/"

  # Everything else goes to /opt/1Password, minus what was installed above and
  # upstream's policy installer (1password.install does its job). The policy
  # template stays for 1password.install to fill in.
  rm -r resources/icons resources/com.onepassword.OnePassword.desktop \
    resources/custom_allowed_browsers install_biometrics_policy.sh
  install -dm755 "${pkgdir}/opt"
  cp -a --no-preserve=ownership . "${pkgdir}/opt/1Password"

  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/1Password/1password "${pkgdir}/usr/bin/1password"

  # Electron's sandbox helper must be setuid root.
  chmod 4755 "${pkgdir}/opt/1Password/chrome-sandbox"
}
