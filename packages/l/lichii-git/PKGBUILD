# Maintainer: BiosPlus <9003059+BiosPlus@users.noreply.github.com>
# Contributor: Claude <noreply@anthropic.com>
#
# Upstream: https://github.com/zortos293/Lichii (by zortos293), a fork of
# Eden. Builds upstream's default branch (nx2). Not on the AUR; the PKGBUILD
# is written here; its build options are adapted from the AUR eden-git package.

_pkgname=lichii
pkgname=lichii-git
pkgver=0.1.0.r0.g0000000
pkgrel=2
pkgdesc="Experimental Nintendo Switch and Switch 2 emulator, fork of Eden (git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/zortos293/Lichii"
license=('GPL-3.0-or-later')
provides=('lichii')
conflicts=('lichii' 'lichii-bin')
depends=('libusb' 'qt6-webengine' 'brotli' 'qt6-charts' 'hicolor-icon-theme'
         'qt6-base' 'sdl3' 'quazip-qt6' 'qt6-multimedia' 'fmt' 'boost-libs'
         'opus' 'enet' 'cubeb' 'game-devices-udev' 'zlib' 'openssl' 'libgcc'
         'libstdc++' 'lz4' 'glibc' 'zstd' 'ffmpeg')
makedepends=('git' 'cmake' 'catch2' 'boost' 'spirv-headers' 'vulkan-headers'
             'vulkan-utility-libraries' 'nlohmann-json' 'ninja' 'gamemode'
             'renderdoc' 'qt6-tools' 'nasm' 'opencl-headers' 'doxygen')
optdepends=('gamemode: Feral GameMode support'
            'vulkan-driver: Vulkan renderer')
options=('!debug')
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf '%s.r%s.g%s' \
    "$(sed -n '1{s/-/./g;p}' VERSION)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  export CFLAGS="${CFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS/}"
  export CXXFLAGS="${CXXFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS/}"
  cmake -B build -S "$_pkgname" -GNinja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DYUZU_USE_BUNDLED_FFMPEG=OFF \
    -DYUZU_USE_BUNDLED_SDL3=OFF \
    -DYUZU_USE_BUNDLED_QT=OFF \
    -DYUZU_USE_BUNDLED_OPENSSL=OFF \
    -Dxbyak_FORCE_BUNDLED=ON \
    -DENABLE_QT_TRANSLATION=ON \
    -DYUZU_USE_QT_MULTIMEDIA=ON \
    -DYUZU_USE_QT_WEB_ENGINE=ON \
    -DYUZU_TESTS=OFF \
    -DDYNARMIC_TESTS=OFF \
    -DBUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # The eden packages own /usr/bin/eden-cli and eden-room: keep this
  # package's command-line tools under their own names, as lichii-bin does.
  local _bin="$pkgdir/usr/bin" _f
  for _f in eden-cli yuzu-cmd; do
    [[ -e "$_bin/$_f" ]] && mv "$_bin/$_f" "$_bin/lichii-cli"
  done
  for _f in eden-room yuzu-room; do
    [[ -e "$_bin/$_f" ]] && mv "$_bin/$_f" "$_bin/lichii-room"
  done

  cd "$srcdir/$_pkgname/dist"
  install -Dm644 io.github.zortos293.lichii.desktop \
    "$pkgdir/usr/share/applications/io.github.zortos293.lichii.desktop"
  install -Dm644 io.github.zortos293.lichii.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.zortos293.lichii.metainfo.xml"
  install -Dm644 lichii.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.zortos293.lichii.png"

  cd "$srcdir/$_pkgname/LICENSES"
  for _f in *.txt; do
    install -Dm644 "$_f" "$pkgdir/usr/share/licenses/$pkgname/$_f"
  done
}
