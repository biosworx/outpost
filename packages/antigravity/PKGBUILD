# Contributor: Claude <noreply@anthropic.com>
#
# Repackages Google's release tarball, following the AUR `antigravity`
# package (which also supplies the desktop entry and icon). No update.conf:
# the download URL has a build number that only Google's site announces.

pkgname=antigravity
pkgver=2.26.0
pkgrel=1
_build=6546645232517120
pkgdesc="Google Antigravity multi-agent orchestration platform"
arch=('x86_64')
url="https://antigravity.google/product/antigravity-2"
license=('LicenseRef-Google-Antigravity')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'glibc'
         'gtk3' 'libcups' 'libgcc' 'libx11' 'libxcb' 'libxcomposite'
         'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa'
         'nspr' 'nss' 'pango' 'systemd-libs')
options=('!strip' '!debug')
source=("Antigravity-${pkgver}-x86_64.tar.gz::https://storage.googleapis.com/antigravity-public/antigravity-hub/${pkgver}-${_build}/linux-x64/Antigravity.tar.gz"
        "${pkgname}.desktop"
        "${pkgname}.png")
b2sums=('75aebaba2854d4ee7823eeba51e16a5246b03314609b78514c17ae15d9316989b1a3ff9bfe0508efe8e6fb41ffe09b57f88182a89a2d8143426847719fb9a28f'
        'ec2c74f0e6f2458f2ef1c67b1321c058a3f7c422e364d8871a0a933220ec52ee5736e449cb797b6f135cff1f4adfe6f81e0fdbc76d3ec67c245aea002b8577d8'
        '772849ebf4574dccc7d2fc30751baed10b4a5d4091c524f3d69938192387693501c0c54ea5b43fa2ed382f70ecdff369a4c65ce3d0f778c68712fa0c2b5e84b8')

package() {
  install -dm755 "${pkgdir}/opt"
  cp -a --no-preserve=ownership Antigravity-*/ "${pkgdir}/opt/Antigravity"

  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/Antigravity/antigravity "${pkgdir}/usr/bin/${pkgname}"

  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -s /opt/Antigravity/LICENSE.electron.txt -t "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -s /opt/Antigravity/LICENSES.chromium.html -t "${pkgdir}/usr/share/licenses/${pkgname}"

  install -Dm644 "${pkgname}.desktop" -t "${pkgdir}/usr/share/applications"
  install -Dm644 "${pkgname}.png" -t "${pkgdir}/usr/share/pixmaps"
}
