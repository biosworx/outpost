# Maintainer: BiosPlus <9003059+BiosPlus@users.noreply.github.com>
# Contributor: Claude <noreply@anthropic.com>
#
# Built from upstream's master branch, following Arch's [extra]
# `jellyfin-server` package. Same file layout, so it swaps in for it (and for
# jellyfin-server-bin) without touching /var/lib/jellyfin.

pkgname=jellyfin-server-git
_pkgname=jellyfin
pkgver=13.0.0.r29680.g0000000
pkgrel=1
pkgdesc="Jellyfin server backend (development version)"
arch=('x86_64')
url="https://jellyfin.org"
_url="https://github.com/jellyfin/jellyfin"
license=('GPL-2.0-or-later')
depends=('glibc' 'libgcc' 'libstdc++' 'aspnet-runtime-10.0' 'bash' 'sqlite'
         'fontconfig' 'jellyfin-ffmpeg' 'jemalloc')
makedepends=('git' 'dotnet-sdk-10.0' 'aspnet-targeting-pack-10.0')
optdepends=(
  'jellyfin-web: to run web-app on the same machine'
  'noto-fonts: for text titles in library folders'
)
provides=('jellyfin-server')
conflicts=('jellyfin-server')
backup=('etc/jellyfin/logging.json' 'etc/jellyfin/jellyfin.env')
options=('!debug')
source=("${_pkgname}::git+${_url}.git"
        "jellyfin-packaging::git+${_url}-packaging.git"
        'sysusers.conf'
        'tmpfiles.conf')
sha256sums=('SKIP'
            'SKIP'
            '53c80d0467e4d0104120d617fda5f4a9308daaee1328cdd2b59c7bddf0b3b1e3'
            '67766e0cca84127ea8f648b1b2e781fdeaeda931ab452ce7045c5de620b88d8d')

pkgver() {
  cd "${_pkgname}"
  # Master carries the next release's version, e.g. 13.0.0.r29680.g1a2b3c4.
  printf '%s.r%s.g%s' \
    "$(sed -n 's/^\[assembly: AssemblyVersion("\(.*\)")\]$/\1/p' SharedVersion.cs)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd jellyfin-packaging/debian/conf
  # Arch keeps the env file in /etc/jellyfin and preloads the system jemalloc
  # (https://github.com/jellyfin/jellyfin/issues/11588). Done with sed rather
  # than Arch's patches so it survives unrelated changes on master; the greps
  # fail the build if upstream renames what is being replaced.
  sed -i 's|^EnvironmentFile = /etc/default/jellyfin$|EnvironmentFile = /etc/jellyfin/jellyfin.env|' jellyfin.service
  sed -i 's|^LD_PRELOAD=.*|LD_PRELOAD=/usr/lib/libjemalloc.so.2|' jellyfin
  grep -qx 'EnvironmentFile = /etc/jellyfin/jellyfin.env' jellyfin.service
  grep -qx 'LD_PRELOAD=/usr/lib/libjemalloc.so.2' jellyfin
}

build() {
  cd "${_pkgname}"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1
  # Keep the NuGet cache out of the builder's home.
  export NUGET_PACKAGES="${srcdir}/nuget"

  dotnet publish Jellyfin.Server \
    --configuration Release \
    --output builddir \
    --self-contained false \
    --os linux \
    -p:DebugSymbols=false \
    -p:DebugType=none
}

package() {
  cd "${_pkgname}"
  install -dm755 "${pkgdir}/usr/bin"
  cp -r --no-preserve=ownership builddir "${pkgdir}/usr/lib/${_pkgname}"
  chmod 755 "${pkgdir}/usr/lib/${_pkgname}/jellyfin"
  ln -s "/usr/lib/${_pkgname}/jellyfin" "${pkgdir}/usr/bin/jellyfin"

  cd "${srcdir}/jellyfin-packaging/debian/conf"
  install -Dm644 jellyfin.service -t "${pkgdir}/usr/lib/systemd/system/"
  install -Dm644 "${srcdir}/sysusers.conf" "${pkgdir}/usr/lib/sysusers.d/${_pkgname}.conf"
  install -Dm644 "${srcdir}/tmpfiles.conf" "${pkgdir}/usr/lib/tmpfiles.d/${_pkgname}.conf"
  # 750, matching tmpfiles.conf.
  install -dm750 "${pkgdir}/etc/${_pkgname}"
  install -Dm640 jellyfin "${pkgdir}/etc/${_pkgname}/${_pkgname}.env"
  install -Dm640 logging.json -t "${pkgdir}/etc/${_pkgname}/"
}
